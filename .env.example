# dotykacka-mcp — proměnné prostředí. Zkopíruj do `.env` (negituje se).
#
# POZOR: tento konektor používá delegovanou OAuth autorizaci (auth.type=
# oauth_delegated). Per-uživatelský refresh_token a cloud_id NEJSOU v env ani
# v manifestu — platforma je doručuje z Vaultu (secret/data/users/{sub}/dotykacka,
# tvar {"refresh_token","cloud_id"}) a SDK z nich přes /v2/signin/token získává
# krátkodobé access tokeny. client_secret drží platforma (operator_fields),
# konektor ho nikdy nevidí.

# --- Společné ---
# Hostovaný konektor běží v režimu hosted (za APISIX gatewayem).
OPENMCP_MODE=hosted

# Salt pro PII pseudonymizaci (HMAC). POVINNÝ — bez něj konektor záměrně
# nenastartuje, protože tokeny by přestaly být stabilní napříč restarty a
# projevilo by se to až po prvním restartu podu.
# Vygeneruj: openssl rand -hex 32
OPENMCP_PII_SALT=replace-with-openssl-rand-hex-32

# Strukturované logování (text pro lokální dev, jinak JSON).
# OPENMCP_LOG_FORMAT=text
# OPENMCP_COMPONENT=mcp-dotykacka

# --- hosted (multi-tenant, za APISIX gatewayem) ---
OPENMCP_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
VAULT_ADDR=https://vault.openmcp.svc.cluster.local:8200
VAULT_ROLE=dotykacka
VAULT_MOUNT=secret
# VAULT_TTL=60
# VAULT_TIMEOUT=10
# PORT=8000
# OPENMCP_ALLOWED_ORIGINS=https://claude.ai

# --- self-hosted (bez gatewaye, konektor si sám ověřuje JWT) ---
# OPENMCP_MODE=self-hosted
# OPENMCP_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
# OIDC_ISSUER=https://auth.openmcp.cz/realms/openmcp
# OIDC_JWKS_URI=https://auth.openmcp.cz/realms/openmcp/protocol/openid-connect/certs
# OIDC_AUDIENCE=dotykacka
# VAULT_ADDR=https://vault.openmcp.svc.cluster.local:8200
# VAULT_ROLE=dotykacka
# VAULT_MOUNT=secret
